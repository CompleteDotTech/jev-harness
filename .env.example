# Nothing in this repository reads environment variables today.
# A future host adapter that talks to Jev keeps the key on ITS server side.
# If you experiment locally, prefer a 1Password reference over a literal:
#   TYPESAFE_API_KEY="op://Development/Jev API Key/password"   # then: op run --env-file=.env -- <cmd>
TYPESAFE_API_KEY=<your-key-never-committed>
